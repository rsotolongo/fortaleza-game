# Copy to terraform.tfvars and adjust. Every value is optional.

# aws_region           = "us-east-1"
# reserved_concurrency = 10      # cost guard; needs a raised Lambda quota on new accounts
# budget_email         = "you@example.com"
# budget_limit_usd     = 5

# Custom domain (the certificate must live in us-east-1):
# domain_name     = "fortaleza.example.com"
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
