<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fortaleza</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\res\messages.es.json" WithCulture="false" LogicalName="Fortaleza.Localization.res.messages.es.json" />
    <EmbeddedResource Include="Localization\res\messages.en.json" WithCulture="false" LogicalName="Fortaleza.Localization.res.messages.en.json" />
  </ItemGroup>
</Project>
